        <p style="margin-bottom:8px"><strong>Cupcake flavors</strong></p>
        <ul class="tag-list">{% for f in flavors.cake %}{% if f.cupcakes %}<li>{{ f.name }}</li>{% endif %}{% endfor %}</ul>
        <p style="margin:16px 0 8px"><strong>Dessert shooter flavors</strong></p>
        <ul class="tag-list">{% for f in flavors.shooters %}<li>{{ f }}</li>{% endfor %}</ul>
