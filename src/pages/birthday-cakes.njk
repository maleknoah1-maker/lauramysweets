{%- import "partials/prices.njk" as prices -%}
{%- import "partials/icons.njk" as i -%}
<section class="section" style="padding-top:0">
  <div class="wrap split">
    <div class="prose reveal" style="margin:0">
      <h2 style="margin-top:0">A cake that fits <em>the birthday.</em></h2>
      <p>Whether it's a third birthday or a fortieth, Laura designs each cake around the person it's for: their favorite colors, a theme they love, or a simple, elegant look. Every birthday cake is baked to order in {{ settings.city }} and finished in vanilla buttercream, with your choice of cake flavor and filling.</p>
      <p>Families order from Allentown, Bethlehem, Center Valley, Hellertown, Emmaus, Quakertown and towns across the Lehigh Valley, with pickup in {{ settings.city }} or delivery.</p>
      <div class="notice">
        <p><strong>Need it sooner?</strong> Quick Order cakes are set designs ready with {{ quickOrder.noticeDays }} days' notice, from {{ computed.quickFrom | money }}. <a href="/quick-order/" data-track="quick_order_click">See Quick Order cakes</a></p>
      </div>
      <div style="margin-top:24px">{{ prices.flavors(flavors) }}</div>
    </div>
    <div class="price-grid" style="grid-template-columns:1fr">
      {{ prices.cakes(menu) }}
      {{ prices.cupcakes(menu) }}
      <p><a class="btn btn-outline" href="/menu/">Full menu and prices</a></p>
    </div>
  </div>
</section>
