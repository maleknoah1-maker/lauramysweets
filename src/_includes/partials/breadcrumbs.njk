{#- Builds the trail from `crumbs` (list of page keys or {label,url}) plus this page. -#}
<nav class="breadcrumbs wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {%- for c in crumbs or [] %}
    {%- set item = pages[c] if pages[c] else c %}
    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
    {%- endfor %}
    <li aria-current="page">{{ crumbLabel or (pages[key].label if key and pages[key] else title) }}</li>
  </ol>
</nav>
