{# Line icons, stroke 1.6. Decorative unless a label is passed. #}
{% macro icon(name, size=20, stroke="currentColor") -%}
<svg aria-hidden="true" focusable="false" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="{{ stroke }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "cake" -%}<path d="M9 4.5c0-1 1.2-1.6 2-.8l1 1 1-1c.8-.8 2-.2 2 .8 0 1.4-3 3-3 3s-3-1.6-3-3z"/><rect x="8" y="9" width="8" height="3.5" rx=".6"/><rect x="6" y="12.5" width="12" height="3.5" rx=".6"/><rect x="4" y="16" width="16" height="3.5" rx=".6"/><path d="M2.5 21h19"/>
{%- elif name == "arrow" -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == "check" -%}<path d="M5 12l5 5 9-10"/>
{%- elif name == "chat" -%}<path d="M4 5h16v11H9l-5 4z"/>
{%- elif name == "phone" -%}<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
{%- elif name == "menu" -%}<path d="M5 9h14M5 15h14"/>
{%- elif name == "close" -%}<path d="M6 6l12 12M18 6L6 18"/>
{%- elif name == "chevron" -%}<path d="M6 9l6 6 6-6"/>
{%- elif name == "mail" -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{%- elif name == "pin" -%}<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>
{%- elif name == "facebook" -%}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>
{%- elif name == "instagram" -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6"/>
{%- elif name == "shield" -%}<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
{%- elif name == "whisk" -%}<path d="M14 10l7-7M9.5 4.5c3-1 7 3 6 6s-6.5 7.5-9 9-4-1-2.5-3.5 2.5-10.5 5.5-11.5z"/>
{%- elif name == "calendar" -%}<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro checkDot() -%}
<span class="check-dot" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#292325" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg></span>
{%- endmacro %}
