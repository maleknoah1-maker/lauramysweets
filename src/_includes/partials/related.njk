{%- import "partials/icons.njk" as i -%}
<section class="section related" aria-labelledby="related-title">
  <div class="wrap">
    <h2 id="related-title" class="related-title">You might also <em>like</em></h2>
    <ul class="related-list">
      {%- for k in related %}
      {%- set r = pages[k] %}
      <li>
        <a href="{{ r.url }}">
          <strong>{{ r.label }}</strong>
          {%- if r.blurb %}<span>{{ r.blurb }}</span>{% endif %}
          {{ i.icon("arrow", 18) }}
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
